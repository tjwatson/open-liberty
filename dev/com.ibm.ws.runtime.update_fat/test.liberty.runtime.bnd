-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0.0

Bundle-Name: Test bundle providing shutdown hooks
Bundle-SymbolicName: test.liberty.runtime
Bundle-Description: Test bundle providing server shutdown hooks; version=${bVersion}

Import-Package: *

Include-Resource:\
 OSGI-INF/metatype/metatype.xml=test-bundles/test.liberty.runtime/resources/OSGI-INF/metatype/metatype.xml

# hide the implementation packages
Private-Package: \
  test.liberty.runtime
  
-dsannotations: \
  test.liberty.runtime.TestLibertyRuntime


 